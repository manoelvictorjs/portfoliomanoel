# Copie para .env.local — NUNCA commite .env.local na Vercel/GitHub.
# Na Vercel: Project → Settings → Environment Variables (somente servidor quando indicado).

# --- Público (exposto no bundle do navegador) ---
NEXT_PUBLIC_DEV_NAME=Manoel Victor
NEXT_PUBLIC_DEV_EMAIL=seu@email.com
NEXT_PUBLIC_PHONE=48999999999
NEXT_PUBLIC_PHONE_E164=5548999999999
NEXT_PUBLIC_GITHUB_USERNAME=seuusuario
NEXT_PUBLIC_GITHUB_URL=https://github.com/seuusuario/portifolio_foda
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/seu-perfil/
NEXT_PUBLIC_CI_BADGE_URL=https://github.com/seuusuario/portifolio_foda/actions
# NEXT_PUBLIC_RM_ECOPECAS_URL=https://seu-projeto.com.br/
# NEXT_PUBLIC_POMODORO_URL=https://seu-pomodoro.vercel.app/
# Currículo PDF — arquivo em public/ ou link HTTPS
# NEXT_PUBLIC_RESUME_URL=/curriculo-manoel-victor.pdf
# NEXT_PUBLIC_RESUME_FILENAME=Manoel-Victor-Curriculo.pdf

# Dev: origens extras para HMR (ex.: IP da rede local — vírgula separada)
# ALLOWED_DEV_ORIGINS=192.168.1.10,192.168.0.5

# --- Servidor (NÃO use prefixo NEXT_PUBLIC_) ---
# Token GitHub — opcional, aumenta rate limit da API (Settings → Secrets na Vercel)
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo

# Monitor na VPS (HTTPS obrigatório; paths /system-stats e /docker/stats)
# VPS_API_BASE_URL=https://monitor.seudominio.com
# VPS_API_SECRET=chave-longa-aleatoria
# VPS_HOSTNAME=portfolio-vps
